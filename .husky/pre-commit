#!/usr/bin/env sh
# Prefer locally built CLI (dev); fall back to npm binary after publish.
if [ -x target/debug/fua-fua ]; then
  target/debug/fua-fua --only-staged --config .fua/config.json
elif [ -x target/release/fua-fua ]; then
  target/release/fua-fua --only-staged --config .fua/config.json
else
  npx fua-fua --only-staged --config .fua/config.json
fi
